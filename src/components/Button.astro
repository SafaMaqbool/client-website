---
interface Props {
  href?: string;
  variant?: "primary" | "dark";
  class?: string;
}

const { href = "#", variant = "primary", class: className = "" } = Astro.props;
const base = "inline-flex items-center justify-center gap-[10px] p-4 rounded-lg transition-opacity hover:opacity-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/80";
const styles = variant === "primary" ? "bg-accent text-white" : "bg-ink text-white";
---
<a href={href} class:list={[base, styles, className]}>
  <span class:list={["size-[6px]", "shrink-0", variant === "primary" ? "bg-ink" : "bg-accent"]}></span>
  <span class="font-medium text-sm leading-none whitespace-nowrap"><slot /></span>
</a>
