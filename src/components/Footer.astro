---
import { Image } from "astro:assets";
import { footerNavigation, groupCompanies, serviceItems, site } from "../data/site";
import logo from "../assets/images/logo-7yrds-bau.jpg";
---
<footer class="bg-white flex flex-col gap-16 items-start pb-12.5 pt-20 px-6 md:px-15 w-full">
  <div class="flex items-start justify-between w-full flex-wrap gap-12">
    <div class="flex flex-col gap-5 items-start w-full sm:w-84.75">
      <div class="flex flex-col gap-7 items-start w-full">
        <a href="/" aria-label="Zur Startseite" title="Zur Startseite">
          <Image src={logo} alt="7YRDS Bau" class="h-20 md:h-25.5 w-auto" loading="lazy" widths={[240, 480]} sizes="230px" />
        </a>
        <p class="font-normal text-base text-ink/60 leading-normal">
          Mittelständisches Bauunternehmen mit Sitz in Goch, NRW. Qualität, Termintreue und Wirtschaftlichkeit seit über 15 Jahren.
        </p>
      </div>
      <div class="flex flex-col gap-2 items-start font-normal text-base leading-normal">
        <p class="text-ink">{site.street} · {site.city}</p>
        <a href={site.phoneHref} class="text-navy hover:text-accent">{site.phone}</a>
        <a href={site.emailHref} class="text-navy hover:text-accent">{site.email}</a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex gap-x-8 gap-y-10 lg:gap-13.5 items-start text-ink text-base w-full lg:w-auto">
      <div class="flex flex-col gap-5 items-start lg:w-49.25">
        <p class="font-semibold leading-[1.2] tracking-[-0.64px] uppercase">Navigation</p>
        <div class="flex flex-col gap-3 items-start font-normal">
          {footerNavigation.map((item) => <a href={item.href} class="leading-normal hover:text-accent">{item.label}</a>)}
        </div>
      </div>
      <div class="flex flex-col gap-5 items-start lg:w-49">
        <p class="font-semibold leading-[1.2] tracking-[-0.64px] uppercase">Leistungen</p>
        <div class="flex flex-col gap-3 items-start font-normal">
          {serviceItems.map((item) => <a href={item.href} class="leading-normal hover:text-accent break-words hyphens-auto">{item.label}</a>)}
        </div>
      </div>
      <div class="flex flex-col gap-5 items-start lg:w-49.25">
        <p class="font-semibold leading-[1.2] tracking-[-0.64px] uppercase">7YRDS Gruppe</p>
        <div class="flex flex-col gap-3 items-start font-normal">
          {groupCompanies.filter((c) => c.label !== "7YRDS").map((c) => (
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="leading-normal hover:text-accent">{c.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-[#dbe0ec] flex items-center justify-between pt-4.5 w-full flex-wrap gap-4">
    <p class="font-normal text-ink text-base leading-normal max-w-112">
      © {new Date().getFullYear()} {site.legalName} · USt-IdNr. {site.vatId} · {site.court} {site.hrb}
    </p>
    <div class="flex gap-5 items-center flex-wrap">
      <div class="flex gap-5 items-center text-ink whitespace-nowrap">
        <span class="text-base">Impressum</span>
        <span class="text-base">Datenschutz</span>
      </div>
      <div class="bg-[#f6f8fb] border border-navy flex gap-3 items-center pl-3 pr-4.5 py-2.5 rounded-lg shrink-0">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#07255C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="flex flex-col gap-0.5 items-start text-xs whitespace-nowrap">
          <span class="font-semibold text-navy">Präqualifiziert · Nr. {site.prequalification}</span>
          <span class="font-normal text-[rgba(5,104,253,0.7)]">{site.registration}</span>
        </div>
      </div>
    </div>
  </div>
</footer>
