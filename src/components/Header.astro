---
import { navItems } from "../data/site";

const currentPath = Astro.url.pathname;
const isActiveLink = (href: string) => {
  if (href === "/") return currentPath === "/";
  const section = `/${href.split("/")[1]}`;
  return currentPath === section || currentPath.startsWith(`${section}/`);
};
---
<header class="relative bg-white flex flex-col justify-center overflow-visible px-5 md:px-10 rounded-2xl shadow-[0px_6px_24px_0px_rgba(0,0,0,0.08)] w-full max-w-7xl mx-auto">
  <input type="checkbox" id="mobile-nav-toggle" class="peer hidden" />

  <div class="flex items-center justify-between w-full gap-4 h-16 md:h-20 peer-checked:[&_.icon-open]:hidden peer-checked:[&_.icon-close]:block">
    <a href="/" class="bg-ink h-8 w-27 md:h-9.5 md:w-31.75 shrink-0" aria-label="Zur Startseite" title="Zur Startseite"></a>

    <nav aria-label="Hauptnavigation" class="hidden xl:flex items-center justify-center flex-1">
      <div class="flex gap-8 items-center px-10">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-1.5 shrink-0 text-[15.1px] leading-6 transition-colors",
              isActiveLink(item.href)
                ? "font-semibold text-ink underline underline-offset-4"
                : "font-normal text-ink hover:text-accent",
            ]}
          >
            {item.label}
            {item.dropdown && (
              <svg width="11" height="7" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M1 1L5.5 5.5L10 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </nav>

    <a href="/kontakt" class="hidden xl:flex bg-sand items-center justify-center px-4.5 py-2.5 rounded-lg shrink-0 hover:opacity-95 transition-opacity">
      <span class="font-semibold text-ink text-xs leading-4">Kontaktieren Sie uns</span>
    </a>

    <label
      for="mobile-nav-toggle"
      class="xl:hidden flex items-center justify-center size-10 shrink-0 cursor-pointer"
      aria-label="Menü öffnen"
    >
      <svg class="icon-open" width="22" height="16" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M1 1H21M1 8H21M1 15H21" stroke="#1D1B24" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <svg class="icon-close hidden" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M1 1L17 17M17 1L1 17" stroke="#1D1B24" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </label>
  </div>

  <div class="hidden peer-checked:flex xl:hidden flex-col items-start gap-1 pb-5 w-full border-t border-sand pt-4">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          "w-full py-2 text-[15.1px] leading-6",
          isActiveLink(item.href) ? "font-semibold text-ink" : "font-normal text-ink hover:text-accent",
        ]}
      >
        {item.label}
      </a>
    ))}
    <a href="/kontakt" class="mt-2 bg-sand flex items-center justify-center px-4.5 py-2.5 rounded-lg shrink-0 w-full hover:opacity-95 transition-opacity">
      <span class="font-semibold text-ink text-xs leading-4">Kontaktieren Sie uns</span>
    </a>
  </div>
</header>
