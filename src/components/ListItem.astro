---
interface Props {
  number: number;
}
const { number } = Astro.props;
---
<li class="flex gap-3 items-start border-b border-[#dbe0ec] py-2.5 w-full">
  <span class="font-bold text-skyblue text-xl tracking-[-0.8px] w-5 shrink-0">{number}.</span>
  <p class="flex-1 font-normal text-ink text-lg leading-[1.2] tracking-[-0.72px]"><slot /></p>
</li>
