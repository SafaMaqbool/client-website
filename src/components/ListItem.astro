---
interface Props {
  number: number;
}
const { number } = Astro.props;
---
<li class="flex gap-3 items-start w-full">
  <span class="bg-sand flex items-center justify-center rounded-full size-6 shrink-0 font-semibold text-ink text-xs">{number}</span>
  <p class="font-normal text-[#171b1f] text-base leading-[1.4] pt-0.5"><slot /></p>
</li>
