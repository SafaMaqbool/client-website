---
interface Props {
  title: string;
  location: string;
  gfa: string;
  date: string;
  status: "Fertiggestellt" | "In Arbeit";
  image: string;
}
const { title, location, gfa, date, status, image } = Astro.props;
const isDone = status === "Fertiggestellt";
---
<div class="flex flex-col md:flex-row items-stretch w-full md:h-105 overflow-hidden rounded-2xl md:rounded-none">
  <div class="bg-[#f3f7fd] flex flex-col justify-between gap-10 items-start px-8 py-10 md:px-15 md:py-20 w-full md:w-101 shrink-0">
    <div class="flex flex-col gap-1.5 items-start w-full">
      <div
        class:list={[
          "flex gap-1.5 items-center px-3.5 py-2 rounded-full border",
          isDone ? "bg-[#f1faf4] border-[#136627]" : "bg-accent/10 border-accent",
        ]}
      >
        <span class:list={["size-1.5 shrink-0 rounded-full", isDone ? "bg-[#136627]" : "bg-accent"]}></span>
        <p class="font-medium text-ink text-sm leading-normal whitespace-nowrap">
          {isDone ? `Fertigstellung: ${date}` : status}
        </p>
      </div>
      <p class="font-bold text-ink text-2xl leading-normal">{title}</p>
      <div class="flex gap-2.5 items-center w-full">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="#6a6a6a" stroke-width="1.5" />
          <circle cx="12" cy="10" r="3" stroke="#6a6a6a" stroke-width="1.5" />
        </svg>
        <p class="flex-1 font-medium text-muted text-base leading-normal">{location}</p>
      </div>
    </div>
    <div class="flex items-end justify-between w-full">
      <div class="flex flex-col gap-0.5 items-start">
        <p class="font-medium text-[#999] text-lg leading-normal">GFA</p>
        <p class="font-semibold text-ink text-2xl leading-normal">{gfa}</p>
      </div>
      <p class="font-medium text-accent text-lg leading-normal whitespace-nowrap">{date}</p>
    </div>
  </div>
  <div class="flex-1 min-w-0 h-64 md:h-full">
    <img src={image} alt={title} class="w-full h-full object-cover" />
  </div>
</div>
