---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ContactCTA from "../components/ContactCTA.astro";
 import CornerGrid from "../components/CornerGrid.astro";

const audiences = [
  { label: "Private Auftraggeber", icon: "/icons/private.svg" },
  { label: "Gewerbliche Bauherren", icon: "/icons/gewerbe.svg" },
  { label: "Öffentliche Hand", icon: "/icons/oeffentliche-hand.svg" },
  { label: "Projektentwickler", icon: "/icons/projektentwickler.svg" },
  { label: "Architekten & Planer", icon: "/icons/architekten.svg" },
];

const stats = [
  { value: "80+", label: "Projekte fertiggestellt" },
  { value: "15+", label: "Jahre Erfahrung" },
  { value: "25M€", label: "Umsatz in 2025" },
];

const services = [
  {
    title: "Generalunternehmer- leistungen",
    image: "/images/service-1.jpg",
    href: "/leistungen/generalunternehmer",
  },
  {
    title: "Planung und Architektur",
    image: "/images/service-2.jpg",
    href: "/leistungen/planung-architektur",
  },
  {
    title: "Rohbauarbeiten",
    image: "/images/service-3.jpg",
    href: "/leistungen/rohbauarbeiten",
  },
  {
    title: "Tiefbauarbeiten",
    image: "/images/service-4.jpg",
    href: "/leistungen/tiefbauarbeiten",
  },
  {
    title: "Heizung- und Sanitärarbeiten",
    image: "/images/service-5.jpg",
    href: "/leistungen/heizung-sanitaer",
  },
  {
    title: "Stahlhallenbau",
    image: "/images/service-6.jpg",
    href: "/leistungen/stahlhallenbau",
  },
  {
    title: "Photovoltaikanlagen",
    image: "/images/service-7.jpg",
    href: "/leistungen/photovoltaikanlagen",
  },
];
---

<Layout title="Wir bauen Zukunft! | Bauunternehmen Goch, NRW">
  <!-- Hero -->
  <section
    class="relative flex flex-col items-center pt-5 pb-10 w-full overflow-hidden"
  >
    <img
      src="/images/hero-bg.jpg"
      alt="Baustelle mit Kran"
      class="absolute inset-0 w-full object-cover z-0"
    />
    <div class="absolute inset-0 bg-black/35 z-10"></div>
    <CornerGrid class="absolute -top-1 -left-1 w-78.75 h-60.5 opacity-20 rotate-180 z-10" />
    <CornerGrid class="absolute -bottom-1 -right-1 w-78.75 h-60.5 opacity-20 z-10" />

    <div
      class="flex flex-col items-start justify-center z-20 relative w-full max-w-310 pt-32 pb-16"
    >
      <div class="flex flex-col gap-8 items-start max-w-164 px-15">
        <div class="flex flex-col gap-4 items-start w-full">
          <div class="flex gap-2.5 items-center">
            <span class="bg-accent size-1.5 shrink-0"></span>
            <p
              class="font-medium text-sm text-white leading-none whitespace-nowrap"
            >
              Goch, NRW · Since 2009
            </p>
          </div>
          <div
            class="flex flex-col gap-1 font-semibold leading-none text-[65px] tracking-[-2.6px] w-full"
          >
            <h1 class="text-white">Wir bauen</h1>
            <h1 class="text-accent">Zukunft!</h1>
          </div>
          <p
            class="font-normal text-white text-xl leading-[1.2] tracking-[-0.8px] max-w-129.25"
          >
            Von der Planung bis zur schlüsselfertigen Übergabe. Wir decken das
            gesamte Spektrum des Bauens ab. Ein Partner, eine Verantwortung, ein
            Qualitätsanspruch.
          </p>
        </div>
        <Button href="/kontakt" variant="dark">Kontaktieren Sie uns</Button>
      </div>
    </div>

    <div class="relative z-20 bg-skyblue flex w-full max-w-7xl p-4">
      {
        audiences.map((a, i) => (
          <div
            class:list={[
              "bg-skyblue flex-1 flex items-center gap-3 p-5",
              i < audiences.length - 1 && "border-r border-skyblueLine",
            ]}
          >
            <img src={a.icon} alt="" class="w-20 h-20 shrink-0" />
            <p class="font-bold text-base text-black leading-normal">
              {a.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Über uns intro -->
  <section
    class="bg-white flex flex-col md:flex-row gap-25 items-center px-15 py-20 w-full"
  >
    <div class="flex-1 h-122 rounded-lg overflow-hidden">
      <img
        src="/images/about-card.jpg"
        alt="Energieverbrauchsdaten auf einem Display"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="flex flex-1 flex-col gap-12.5 items-end justify-center">
      <div class="flex flex-col gap-4 items-start w-full">
        <div class="flex gap-2.5 items-center">
          <span class="bg-accent size-1.5 shrink-0"></span>
          <p class="font-medium text-ink text-sm leading-none">Über uns</p>
        </div>
        <h2 class="font-display text-ink text-[40px] tracking-[-1.6px]">
          Regional und vertrauensvoller Partner.
        </h2>
      </div>
      <div class="flex gap-5 items-start w-full">
        <p
          class="flex-1 font-normal text-[#171b1f] text-lg leading-[1.2] tracking-[-0.72px]"
        >
          Als regional verwurzeltes Unternehmen legen wir großen Wert auf eine
          partnerschaftliche Zusammenarbeit mit unseren Auftraggebern,
          Architekten und Nachunternehmern.
        </p>
        <p
          class="flex-1 font-normal text-[#171b1f] text-lg leading-[1.2] tracking-[-0.72px]"
        >
          Mit Innovationskraft und einem klaren Blick in die Zukunft entwickeln
          wir maßgeschneiderte Lösungen – von der ersten Idee bis zur
          erfolgreichen Umsetzung.
        </p>
      </div>
      <Button href="/ueber-uns">mehr über uns</Button>
    </div>
  </section>

  <!-- Stats -->
  <section
    class="bg-white flex flex-col md:flex-row gap-7.5 items-start pb-20 pt-10 px-15 w-full"
  >
    {
      stats.map((s) => (
        <div class="bg-sand flex flex-1 flex-col gap-6 h-59.25 items-start px-10 py-8 rounded-2xl">
          <div class="flex flex-col gap-2 items-start text-black w-full">
            <h2 class="font-semibold leading-none text-[50px] tracking-[-1px] w-full">
              {s.value}
            </h2>
            <p class="font-normal leading-[1.2] text-lg tracking-[-0.72px] w-full">
              {s.label}
            </p>
          </div>
        </div>
      ))
    }
  </section>

  <!-- Construction photo banner -->
  <section class="flex flex-col h-125 md:h-158.75 items-start px-6 w-full">
    <img
      src="/images/construction-photo.jpg"
      alt="Bauarbeiter auf einer Baustelle"
      class="w-full h-full object-cover"
    />
  </section>

  <!-- Services -->
  <section
    class="bg-white flex flex-col gap-12.5 items-start px-15 py-20 w-full"
  >
    <div class="flex items-end justify-between w-full flex-wrap gap-6">
      <div class="flex flex-col gap-4 items-start max-w-132.5">
        <div class="flex gap-2.5 items-center">
          <span class="bg-accent size-1.5 shrink-0"></span>
          <p class="font-medium text-ink text-sm leading-none">
            Dienstleistungen
          </p>
        </div>
        <h2 class="font-display text-ink text-[40px] tracking-[-1.6px]">
          Alle Services aus einer Hand
        </h2>
      </div>
      <Button href="/leistungen">zu Dienstleistungen</Button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 w-full">
      {
        services.map((s) => (
          <a
            href={s.href}
            class="relative z-0 border border-[#a9b9d6] flex flex-col h-56.25 items-end justify-between p-5 overflow-hidden group"
          >
            <img
              src={s.image}
              alt={s.title}
              class="absolute inset-0 w-full h-full object-cover z-0"
            />
            <div class="absolute inset-0 bg-black/40 z-10" />
            <p class="relative z-20 font-normal text-[28px] text-left text-white leading-[1.36] w-full">
              {s.title}
            </p>
          </a>
        ))
      }
      <a
        href="/leistungen"
        class="bg-accent border border-accent flex flex-col h-56.25 items-end justify-between p-5"
      >
        <p
          class="font-normal text-[28px] text-left text-white leading-[1.36] w-full"
        >
          Mehr erfahren
        </p>
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M5 12h14m0 0l-6-6m6 6l-6 6"
            stroke="white"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Projects -->
  <section
    class="bg-skyblue flex flex-col md:flex-row gap-25 items-center px-15 py-10 w-full"
  >
    <div class="flex flex-1 flex-col gap-5 items-start justify-center">
      <h2 class="font-medium text-ink text-[40px] tracking-[-1.6px]">
        Verschiedenste Projekte, gleiche Qualität.
      </h2>
      <div
        class="flex flex-col gap-1.5 items-start text-ink text-sm font-medium"
      >
        <p>Einfamilienhäuser · Doppelhäuser · Reihenhäuser</p>
        <p>Mehrfamilienhäuser · Gewerbehallen · Garagen</p>
        <p>Bürogebäude</p>
      </div>
      <Button href="/referenzen">Referenzen ansehen</Button>
    </div>
    <div class="relative w-155.5 h-118 hidden md:block shrink-0">
      <div
        class="absolute left-25 top-0 w-130.5 h-93 rounded-[20px] overflow-hidden"
      >
        <img
          src="/images/project-2.jpg"
          alt="Referenzprojekt 1"
          class="w-full h-full object-cover"
        />
      </div>
      <div
        class="absolute left-12.5 top-12.5 w-130.5 h-93 rounded-[20px] overflow-hidden"
      >
        <img
          src="/images/project-3.jpg"
          alt="Referenzprojekt 2"
          class="w-full h-full object-cover"
        />
      </div>
      <div
        class="absolute left-0 top-25 w-130.5 h-93 rounded-[20px] overflow-hidden"
      >
        <img
          src="/images/project-1.jpg"
          alt="Referenzprojekt 3"
          class="w-full h-full object-cover"
        />
      </div>
      <div
        class="absolute left-81.25 top-29 bg-[#f1faf4] border border-[#136627] flex gap-1.5 items-center px-3.5 py-2 rounded-[28px]"
      >
        <span class="bg-[#136627] size-1.5 shrink-0"></span>
        <p class="font-medium text-ink text-sm">Fertiggestellt 12/2024</p>
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
