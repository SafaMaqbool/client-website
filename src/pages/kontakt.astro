---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CornerGrid from "../components/CornerGrid.astro";
import Button from "../components/Button.astro";
import { groupCompanies, site } from "../data/site";
import logo from "../assets/images/logo-7yrds-bau.jpg";
import arrowIcon from "../assets/icons/arrow-up-right-circle.svg";

// Spaltenaufteilung wie im Figma-Design (Node 135:4104)
const companyColumns = [
  ["7YRDS Real Estate", "7YRDS Energy", "7YRDS Decon Service", "Cyclontec"],
  ["7YRDS", "7YRDS XXL Garagen", "7YRDS Consulting", "7YRDS Protect"],
  ["7YRDS Consulting", "7YRDS Service", "7YRDS"],
].map((column) => column.map((label) => groupCompanies.find((c) => c.label === label)!));
---
<Layout title="Kontakt | Bauunternehmen Goch, NRW" description="Kontaktieren Sie uns für Ihr nächstes Bauprojekt.">
  <!-- Hero -->
  <section class="relative bg-ink flex flex-col items-center pt-10 pb-14 w-full overflow-hidden">
    <CornerGrid class="absolute -top-1 -left-1 w-78.75 h-60.5 opacity-20 rotate-180 z-0" />

    <div class="h-20 w-full shrink-0"></div>

    <div class="relative z-10 flex flex-col items-start w-full max-w-310 pt-16 pb-6 px-6 md:px-15">
      <h1 class="font-semibold text-white text-[56px] md:text-[80px] leading-none tracking-[-3.2px]">Kontakt</h1>
    </div>
  </section>

  <!-- Kontaktinformationen & Formular -->
  <section class="bg-white flex flex-col lg:flex-row gap-15 items-stretch px-6 md:px-15 py-20 w-full">
    <div class="flex flex-col justify-between gap-10 w-full lg:w-91.25 shrink-0">
      <div class="flex flex-col gap-10 items-start w-full">
        
        <div class="flex gap-2.5 items-center">
          <span class="bg-accent size-1.5 shrink-0"></span>
          <p class="font-medium text-ink text-sm leading-none">Kontaktinformationen</p>
        </div>

        <a href="/" class="shrink-0" aria-label="Zur Startseite" title="Zur Startseite">
          <Image src={logo} alt="7YRDS Bau" class="h-20.25 w-auto" loading="eager" widths={[240, 480]} sizes="182px" />
        </a>


        <div class="flex flex-col gap-4.5 items-start w-full">
          <div class="flex flex-col gap-3 items-start w-full">
            <p class="font-normal text-muted text-base tracking-[-0.64px] uppercase">Adresse</p>
            <div class="flex flex-col gap-1.5 items-start w-full">
              <h2 class="font-semibold text-ink text-lg tracking-[-0.36px]">{site.legalName}</h2>
              <h2 class="font-semibold text-ink text-lg leading-none tracking-[-0.36px]">{site.street}<br />{site.city}</h2>
            </div>
          </div>
          <div class="flex flex-col gap-3 items-start w-full">
            <p class="font-normal text-muted text-base tracking-[-0.64px] uppercase">Telefonnummer</p>
            <a href={site.phoneHref} class="font-semibold text-ink text-lg tracking-[-0.36px] hover:text-accent">{site.phone}</a>
          </div>
          <div class="flex flex-col gap-3 items-start w-full">
            <p class="font-normal text-muted text-base tracking-[-0.64px] uppercase">E-Mail</p>
            <a href={site.emailHref} class="font-semibold text-ink text-lg tracking-[-0.36px] hover:text-accent">{site.email}</a>
          </div>
        </div>
      </div>

      <div class="bg-[#f3f7fd] flex flex-col gap-6 items-start justify-center px-8 md:px-10 py-8 rounded-2xl w-full">
        <svg width="42" height="42" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="#1D1B24" stroke-width="1.3" />
          <ellipse cx="12" cy="12" rx="4" ry="9" stroke="#1D1B24" stroke-width="1.3" />
          <path d="M3 12h18M4.5 7.5h15M4.5 16.5h15" stroke="#1D1B24" stroke-width="1.3" />
        </svg>
        <div class="flex flex-col gap-5 items-start w-full text-lg text-ink">
          <h2 class="font-semibold leading-none tracking-[-0.36px]">Rechtliche Informationen</h2>
          <div class="flex flex-col gap-2 items-start w-full font-normal leading-[1.2] tracking-[-0.72px]">
            <p>USt.-IdNr. {site.vatId}</p>
            <p>{site.court} · {site.hrb}</p>
            <p>Präqualifizierung Nr. {site.prequalification}</p>
          </div>
        </div>
      </div>
    </div>

    <form
      class="bg-[#f3f7fd] flex flex-1 flex-col gap-10.5 items-center justify-center px-6 md:px-10 pt-10 pb-6 rounded-2xl w-full"
      action={`mailto:${site.email}`}
      method="post"
      enctype="text/plain"
    >
      <h2 class="font-display text-[#171b1f] text-[32px] tracking-[-1.28px] w-full">Anfrage senden</h2>

      <div class="flex flex-col gap-6 items-start w-full">
        <div class="flex flex-col sm:flex-row gap-7.5 items-start w-full">
          <div class="flex flex-1 flex-col gap-2.5 items-start w-full">
            <label for="name" class="font-medium text-[#171b1f] text-base tracking-[0.24px]">Ihr Name</label>
            <input type="text" id="name" name="name" required class="bg-[#dae2ef] border border-[#eef4ff] rounded-xl p-3 text-ink w-full focus:outline-none focus:ring-2 focus:ring-accent/50" />
          </div>
          <div class="flex flex-1 flex-col gap-2.5 items-start w-full">
            <label for="phone" class="font-medium text-[#171b1f] text-base tracking-[0.24px]">Telefonnummer</label>
            <input type="tel" id="phone" name="phone" placeholder="+49..." required class="bg-[#dae2ef] border border-[#eef4ff] rounded-xl p-3 text-ink w-full placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/50" />
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-7.5 items-start w-full">
          <div class="flex flex-1 flex-col gap-2.5 items-start w-full">
            <label for="email" class="font-medium text-[#171b1f] text-base tracking-[0.24px]">E-Mail</label>
            <input type="email" id="email" name="email" required class="bg-[#dae2ef] border border-[#eef4ff] rounded-xl p-3 text-ink w-full focus:outline-none focus:ring-2 focus:ring-accent/50" />
          </div>
          <div class="flex flex-1 flex-col gap-2.5 items-start w-full">
            <label for="topic" class="font-medium text-[#171b1f] text-base tracking-[0.24px]">Thema</label>
            <div class="relative w-full">
              <select id="topic" name="topic" required class="appearance-none bg-[#dae2ef] border border-[#eef4ff] rounded-xl p-3 pr-10 text-ink w-full focus:outline-none focus:ring-2 focus:ring-accent/50">
                <option value="">Wählen Sie...</option>
                <option>Generalunternehmerleistungen</option>
                <option>Planung / Architektur</option>
                <option>Rohbauarbeiten</option>
                <option>Tiefbauarbeiten</option>
                <option>Heizung- und Sanitärarbeiten</option>
                <option>Stahlhallenbau</option>
                <option>Photovoltaikanlagen</option>
                <option>Sonstiges</option>
              </select>
              <svg width="14" height="9" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true">
                <path d="M1 1L5.5 5.5L10 1" stroke="#686767" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2.5 items-start w-full">
          <label for="message" class="font-medium text-[#171b1f] text-base tracking-[0.24px]">Ihre Nachricht (optional)</label>
          <textarea id="message" name="message" rows="4" placeholder="Beschreiben Sie Ihr konkretes Anliegen..." class="bg-[#dae2ef] border border-[#eef4ff] rounded-xl p-3 text-ink resize-none w-full h-28 focus:outline-none focus:ring-2 focus:ring-accent/50"></textarea>
        </div>
      </div>

      <div class="flex flex-col gap-3 items-center">
        <Button type="submit" variant="dark">Anfrage senden</Button>
        <p class="font-normal text-[#171b1f] text-base text-center leading-normal">Wir melden uns innerhalb eines Tages</p>
      </div>
    </form>
  </section>

  <!-- 7YRDS Gruppe -->
  <section class="bg-white border-y border-sand flex flex-col gap-8 items-start justify-center px-6 py-12 md:p-15 w-full">
    <div class="flex flex-col gap-4 items-start w-full">
      <div class="flex gap-2.5 items-center">
        <span class="bg-accent size-1.5 shrink-0"></span>
        <p class="font-medium text-[#171b1f] text-sm leading-none">7YRDS Group</p>
      </div>
      <h2 class="font-display text-[#171b1f] text-[32px] md:text-[40px] tracking-[-1.6px] leading-[1.1] md:leading-[1.25]">Weitere Unternehmen aus der 7YRDS Gruppe</h2>
    </div>

    <div class="flex flex-col md:flex-row md:flex-wrap gap-3 md:gap-x-12.5 md:gap-y-3 items-start w-full">
      {companyColumns.map((column) => (
        <div class="flex flex-col gap-3 items-start max-w-full">
          {column.map((c) => (
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-[#e4efff] flex gap-6 items-center px-3.5 py-2.5 rounded-2xl max-w-full hover:bg-[#d6e5fc] transition-colors"
            >
              <span class="flex flex-wrap sm:flex-nowrap gap-x-2 gap-y-1 items-center min-w-0">
                <span class="font-normal text-ink text-sm leading-[1.2] tracking-[-0.56px] sm:whitespace-nowrap">{c.label}</span>
                <span class="font-semibold text-accent text-sm leading-none tracking-[-0.28px] underline underline-offset-2 whitespace-nowrap">{c.domain}</span>
              </span>
              <img src={arrowIcon.src} width={arrowIcon.width} height={arrowIcon.height} alt="" class="shrink-0 size-[24.248px]" />
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>
</Layout>
