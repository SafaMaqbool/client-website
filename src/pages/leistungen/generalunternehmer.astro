---
import Layout from "../../layouts/Layout.astro";
import LeistungenNav from "../../components/LeistungenNav.astro";
import ContactCTA from "../../components/ContactCTA.astro";

const steps = [
  { number: "1", title: "Planung", description: "Individuelle Konzeptentwicklung und Kostenplanung." },
  { number: "2", title: "Koordination", description: "Steuerung aller Gewerke, Nachunternehmer und Lieferanten." },
  { number: "3", title: "Ausführung", description: "Wohn-, Gewerbe- und Industriebau." },
  { number: "4", title: "Schlüsselfertige Übergabe", description: "Termingerecht, im Budget, vollständig." },
];
---
<Layout title="Generalunternehmerleistungen | Bauunternehmen Goch, NRW" description="Alle Bauleistungen aus einer Hand – Planung, Koordination und schlüsselfertige Übergabe.">
  <LeistungenNav />

  <section class="bg-white flex flex-col lg:flex-row items-stretch w-full">
    <div class="bg-[#f3f7fd] flex flex-col justify-between gap-10 items-start px-6 md:px-15 py-12 md:py-20 w-full lg:w-132.5 shrink-0">
      <div class="flex flex-col gap-4 items-start w-full">
        <div class="flex gap-2.5 items-center">
          <span class="bg-accent size-1.5 shrink-0"></span>
          <p class="font-medium text-ink text-sm leading-none">Generalunternehmerleistungen</p>
        </div>
        <h1 class="font-display text-ink text-[40px] leading-[1.1] tracking-[-1.6px]">Alle Bauleistungen aus einer Hand.</h1>
        <p class="font-normal text-ink text-lg leading-[1.2] tracking-[-0.72px]">
          Wir bieten professionelle Generalunternehmerleistungen für Wohn-, Gewerbe- und Industriebauten. Von der Planung über die Koordination sämtlicher Gewerke bis hin zur schlüsselfertigen Übergabe. Termintreue, Qualität und wirtschaftliche Umsetzung stehen dabei im Mittelpunkt unserer Arbeit.
        </p>
      </div>
      <div class="flex items-center justify-between w-full">
        <h2 class="font-display text-ink text-[32px] tracking-[-1.28px]">Unser Prozess</h2>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7V15" stroke="#1D1B24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <div class="flex-1 flex flex-col gap-10 items-start px-6 md:px-15 py-12 md:py-20 w-full">
      <div class="flex flex-col gap-7.5 items-start w-full">
        <h2 class="font-medium text-ink text-[28px] tracking-[-1.12px]">Leistungsübersicht</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 w-full">
          {steps.map((step, i) => (
            <div
              class:list={[
                "flex flex-col gap-1.5 py-6",
                i % 2 === 1 && "sm:border-l sm:border-sand sm:pl-7.5",
                i >= 2 && "border-t border-sand",
              ]}
            >
              <span class="font-display text-accent text-xl">{step.number}</span>
              <h3 class="font-bold text-ink text-base">{step.title}</h3>
              <p class="font-normal text-ink/60 text-base">{step.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-sand flex flex-col gap-6 items-start justify-center px-6 md:px-10 py-8 rounded-2xl w-full">
        <div class="flex items-center justify-between w-full">
          <div class="bg-ink h-15.25 w-34.25 shrink-0" aria-label="Firmenlogo"></div>
          <p class="font-medium text-ink text-[30px] leading-[1.2] tracking-[-1.2px] text-right">Wir bauen Zukunft</p>
        </div>
        <p class="font-normal text-ink text-lg leading-[1.2] tracking-[-0.72px]">
          Termintreue, Qualität und wirtschaftliche Umsetzung stehen dabei im Mittelpunkt unserer Arbeit.
        </p>
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
