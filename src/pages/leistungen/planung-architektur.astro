---
import Layout from "../../layouts/Layout.astro";
import LeistungenNav from "../../components/LeistungenNav.astro";
import ContactCTA from "../../components/ContactCTA.astro";

const processSteps = [
  {
    range: "1–3",
    title: "Grundlagenermittlung, Vorplanung & Entwurfsplanung",
    items: [
      "Analyse Ihrer Anforderungen und Entwicklung eines individuellen Planungskonzepts",
      "Erstellung von Vorentwürfen, Ausführungsvarianten und einer Kostenschätzung",
      "Ausarbeitung der Entwurfsplanung",
    ],
  },
  {
    range: "4–5",
    title: "Genehmigungs- & Ausführungsplanung",
    items: [
      "Erstellung aller erforderlichen Unterlagen für den Bauantrag",
      "Detaillierte Ausführungsplanung als Grundlage für die Bauausführung",
      "Abstimmung aller technischen und gestalterischen Details mit den Fachplanern",
    ],
  },
  {
    range: "6–7",
    title: "Ausschreibung & Vergabe",
    items: [
      "Erstellung von Leistungsverzeichnissen und Ausschreibungsunterlagen",
      "Einholung, Prüfung und Vergleich von Angeboten",
      "Unterstützung bei der Vergabe und Auswahl geeigneter Nachunternehmer",
    ],
  },
  {
    range: "8–9",
    title: "Bauüberwachung & Objektbetreuung",
    items: [
      "Überwachung der Bauausführung hinsichtlich Qualität, Kosten und Terminen",
      "Koordination aller am Bau Beteiligten sowie Begleitung der Abnahme",
      "Betreuung nach Fertigstellung und Begleitung während der Gewährleistungszeit",
    ],
  },
];
---
<Layout title="Planung & Architektur | Bauunternehmen Goch, NRW" description="Architektur- und Planungsleistungen von der ersten Idee bis zur Realisierung.">
  <LeistungenNav />

  <section class="bg-white flex flex-col lg:flex-row items-stretch w-full">
    <div class="bg-[#f3f7fd] flex flex-col justify-between gap-6 items-start px-6 md:px-15 py-12 md:py-20 w-full lg:w-132.5 shrink-0">
      <div class="flex flex-col gap-4 items-start w-full">
        <div class="flex gap-2.5 items-center">
          <span class="bg-accent size-1.5 shrink-0"></span>
          <p class="font-medium text-ink text-sm leading-none">Planung / Architektur</p>
        </div>
        <h1 class="font-display text-ink text-[40px] leading-[1.1] tracking-[-1.6px]">Von der ersten Idee bis zur Realisierung.</h1>
        <p class="font-normal text-ink text-lg leading-[1.2] tracking-[-0.72px]">
          Wir bieten umfassende Architektur- und Planungsleistungen für private und gewerbliche Auftraggeber. Von der ersten Idee bis zur Realisierung begleiten wir Projekte ganzheitlich und mit einem klaren Fokus auf Qualität, Funktionalität und Wirtschaftlichkeit.
        </p>
      </div>
      <div class="w-full max-w-68.75 aspect-275/109 rounded-2xl overflow-hidden [clip-path:polygon(0_0,calc(100%-34px)_0,100%_32px,100%_100%,0_100%)]">
        <img src="/images/planung-hero.jpg" alt="Bauplanung und Architektur" class="w-full h-full object-cover" />
      </div>
      <div class="flex items-center justify-between w-full">
        <h2 class="font-display text-ink text-[32px] tracking-[-1.28px]">Zeichnung/Plan</h2>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
          <path d="M5 12h14m0 0l-6-6m6 6l-6 6" stroke="#1D1B24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <div class="flex-1 flex flex-col items-start px-6 md:px-15 py-12 md:py-20 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 w-full">
        {processSteps.map((step, i) => (
          <div
            class:list={[
              "flex flex-col gap-1.5",
              i % 2 === 0 ? "pr-6.25" : "md:border-l md:border-sand md:pl-7.5",
              i < 2 ? "pb-6.25" : "border-t border-sand pt-6.25",
            ]}
          >
            <span class="font-display text-accent text-xl">{step.range}</span>
            <h3 class="font-bold text-ink text-base">{step.title}</h3>
            <ul class="flex flex-col gap-1">
              {step.items.map((item) => (
                <li class="list-disc ms-6 font-normal text-ink/60 text-base leading-normal">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA variant="accent" />
</Layout>
