---
import Layout from "../../layouts/Layout.astro";
import LeistungenNav from "../../components/LeistungenNav.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import NumberedList from "../../components/NumberedList.astro";
import ListItem from "../../components/ListItem.astro";
---
<Layout title="Planung & Architektur | Bauunternehmen Goch, NRW" description="Architektur- und Planungsleistungen von der ersten Idee bis zur Realisierung.">
  <LeistungenNav />

  <section class="bg-white flex flex-col md:flex-row gap-[60px] items-center px-[60px] py-16 w-full">
    <div class="flex flex-1 flex-col gap-6 items-start">
      <p class="font-medium text-accent text-sm uppercase tracking-wide">Planung / Architektur</p>
      <h1 class="font-display text-ink text-[44px] leading-[1.1] tracking-[-1.6px]">Von der ersten Idee bis zur Realisierung.</h1>
      <p class="font-normal text-[#171b1f] text-lg leading-[1.4] tracking-[-0.4px] max-w-[560px]">
        Wir bieten umfassende Architektur- und Planungsleistungen für private und gewerbliche Auftraggeber. Von der ersten Idee bis zur Realisierung begleiten wir Projekte ganzheitlich und mit einem klaren Fokus auf Qualität, Funktionalität und Wirtschaftlichkeit.
      </p>
    </div>
    <div class="flex-1 w-full h-[360px] rounded-2xl overflow-hidden shrink-0 max-w-[560px]">
      <img src="/images/planung-hero.jpg" alt="Planung auf der Baustelle" class="w-full h-full object-cover" />
    </div>
  </section>

  <section class="bg-white flex flex-col gap-10 items-start px-[60px] pb-20 w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 w-full">
      <NumberedList title="1–3 · Grundlagenermittlung, Vorplanung & Entwurfsplanung">
        <ListItem number={1}>Analyse Ihrer Anforderungen und Entwicklung eines individuellen Planungskonzepts</ListItem>
        <ListItem number={2}>Erstellung von Vorentwürfen, Ausführungsvarianten und einer Kostenschätzung</ListItem>
        <ListItem number={3}>Ausarbeitung der Entwurfsplanung</ListItem>
      </NumberedList>
      <NumberedList title="4–5 · Genehmigungs- & Ausführungsplanung">
        <ListItem number={4}>Erstellung aller erforderlichen Unterlagen für den Bauantrag</ListItem>
        <ListItem number={5}>Detaillierte Ausführungsplanung als Grundlage für die Bauausführung, inkl. Abstimmung mit Fachplanern</ListItem>
      </NumberedList>
      <NumberedList title="6–7 · Ausschreibung & Vergabe">
        <ListItem number={6}>Erstellung von Leistungsverzeichnissen und Ausschreibungsunterlagen</ListItem>
        <ListItem number={7}>Einholung, Prüfung und Vergleich von Angeboten sowie Unterstützung bei der Vergabe geeigneter Nachunternehmer</ListItem>
      </NumberedList>
      <NumberedList title="8–9 · Bauüberwachung & Objektbetreuung">
        <ListItem number={8}>Überwachung der Bauausführung hinsichtlich Qualität, Kosten und Terminen; Koordination aller Beteiligten</ListItem>
        <ListItem number={9}>Betreuung nach Fertigstellung und Begleitung während der Gewährleistungszeit</ListItem>
      </NumberedList>
    </div>
  </section>

  <ContactCTA />
</Layout>
