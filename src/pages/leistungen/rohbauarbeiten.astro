---
import Layout from "../../layouts/Layout.astro";
import LeistungenNav from "../../components/LeistungenNav.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import NumberedList from "../../components/NumberedList.astro";
import ListItem from "../../components/ListItem.astro";
---
<Layout title="Rohbauarbeiten | Bauunternehmen Goch, NRW" description="Die stabile Grundlage für jedes Bauvorhaben.">
  <LeistungenNav />

  <section class="bg-white flex flex-col lg:flex-row items-stretch w-full">
    <div class="bg-[#f3f7fd] flex flex-col gap-4 items-start px-6 md:px-15 py-12 md:py-20 w-full lg:w-132.5 shrink-0">
      <div class="flex gap-2.5 items-center">
        <span class="bg-accent size-1.5 shrink-0"></span>
        <p class="font-medium text-ink text-sm leading-none">Rohbauarbeiten</p>
      </div>
      <h1 class="font-display text-ink text-[40px] leading-[1.1] tracking-[-1.6px]">Die stabile Grundlage für jedes Bauvorhaben.</h1>
      <p class="font-normal text-ink text-lg leading-[1.2] tracking-[-0.72px]">
        Im Bereich Rohbauarbeiten schaffen wir die stabile Grundlage für jedes Bauvorhaben. Mit fachlicher Kompetenz, präziser Ausführung und hochwertigen Materialien realisieren wir tragende Konstruktionen für Wohn-, Gewerbe- und Industriebauten.
      </p>
    </div>

    <div class="flex-1 flex flex-col gap-10 items-start px-6 md:px-15 py-12 md:py-20 w-full">
      <div class="flex flex-col gap-1.5 items-start w-full">
        <h2 class="font-semibold text-ink text-xl tracking-[-0.4px] leading-none">Unser Leistungsspektrum im Rohbau</h2>
        <NumberedList>
          <ListItem number={1}>Erd- und Aushubarbeiten als vorbereitende Maßnahmen</ListItem>
          <ListItem number={2}>Herstellung von Fundamenten und Bodenplatten</ListItem>
          <ListItem number={3}>Errichtung von tragenden Wänden aus Beton, Stahlbeton und Mauerwerk</ListItem>
          <ListItem number={4}>Decken- und Geschosskonstruktionen</ListItem>
          <ListItem number={5}>Schalungs- und Bewehrungsarbeiten</ListItem>
          <ListItem number={6}>Beton- und Stahlbetonarbeiten nach aktuellen Normen</ListItem>
          <ListItem number={7}>Abdichtungsarbeiten im erdberührten Bereich</ListItem>
        </NumberedList>
      </div>
      <p class="font-normal text-ink text-2xl leading-[1.2] tracking-[-0.96px] w-full">
        Durch den Einsatz moderner Bautechniken und qualifizierter Fachkräfte gewährleisten wir höchste Qualität und Sicherheit – als verlässliche Basis für alle weiteren Ausbaugewerke.
      </p>
    </div>
  </section>

  <ContactCTA />
</Layout>
