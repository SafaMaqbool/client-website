---
import Layout from "../layouts/Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import CornerGrid from "../components/CornerGrid.astro";
import ReferenceCategorySection from "../components/ReferenceCategorySection.astro";

interface Project {
  title: string;
  location: string;
  gfa: string;
  date: string;
  status: "Fertiggestellt" | "In Arbeit";
  image: string;
}

const images = Array.from({ length: 9 }, (_, i) => `/images/ref-project-${i + 1}.jpg`);
let imageCursor = 0;
const nextImage = () => images[imageCursor++ % images.length];

const residential: Project[] = [
  { title: "Errichtung von 3 Mehrfamilienhäusern mit je 23 Wohneinheiten", location: "Moerser Straße 403–407, Kamp-Lintfort", gfa: "6,001 m²", date: "01/2022", status: "Fertiggestellt", image: nextImage() },
  { title: "Errichtung von 10 Reihenhäusern", location: "Birkenallee 10a–j, Kalkar", gfa: "1,724 m²", date: "06/2023", status: "Fertiggestellt", image: nextImage() },
  { title: "Errichtung von 2 Mehrfamilienhäusern mit 7 Wohneinheiten und 1 Doppelhaus", location: "Birkenallee 12a–c, Kalkar", gfa: "1,385 m²", date: "09/2023", status: "Fertiggestellt", image: nextImage() },
  { title: "Errichtung eines Mehrfamilienhauses mit 11 Wohneinheiten", location: "Postweg 14c, Kalkar", gfa: "1,350 m²", date: "08/2024", status: "Fertiggestellt", image: nextImage() },
  { title: "Errichtung von 5 Reihenhäusern mit Garagen", location: "Alpener Straße 304, Rheinberg", gfa: "932 m²", date: "11/2024", status: "Fertiggestellt", image: "images/ref-project2024.png" },
  { title: "Errichtung von 12 Doppelhaushälften mit Garagen", location: "Alte Heerstraße 37–59, Weeze", gfa: "2,868 m²", date: "12/2024", status: "Fertiggestellt", image: nextImage() },
  { title: "Errichtung eines Mehrfamilienhauses mit 21 Wohneinheiten", location: "Fichtenweg 2a, Kalkar", gfa: "2,184 m²", date: "12/2024", status: "Fertiggestellt", image: nextImage() },
  { title: "Neubau von 8 Reihenhäusern und 1 Mehrfamilienhaus", location: "Kevelaererstraße 90–100, Weeze", gfa: "2,407 m²", date: "05/2025", status: "Fertiggestellt", image: nextImage() },
  { title: "Neubau von 3 Doppelhäusern mit Garagen", location: "Parkstraße, Sonsbeck", gfa: "1,188 m²", date: "05/2025", status: "Fertiggestellt", image: nextImage() },
  { title: "Gewerbehallen und 66 Garagen in 4 Garagengebäuden", location: "An der Molkerei 13, Bedburg-Hau", gfa: "2,497 m²", date: "10/2025", status: "Fertiggestellt", image: nextImage() },
  { title: "Neubau eines Mehrfamilienhauses mit 31 Wohneinheiten und Stellplatzanlage", location: "Ernst-Holla-Straße 9a–d, Moers", gfa: "3,453 m²", date: "02/2026", status: "Fertiggestellt", image: nextImage() },
  { title: "Neubau Doppelhaus mit Garage", location: "Nierspaß 7+7a, Goch", gfa: "468 m²", date: "02/2026", status: "Fertiggestellt", image: nextImage() },
  { title: "Neubau von 6 Doppelhaushälften und 5 Garagen", location: "Paulstraße 8a+8b / Ebertstraße 84a–d, Kamp-Lintfort", gfa: "1,146 m²", date: "06/2026", status: "Fertiggestellt", image: nextImage() },
];

const commercial: Project[] = [
  { title: "Errichtung von 2 Gewerbehallen und 66 Garagen in 4 Garagengebäuden", location: "An der Molkerei 13, Bedburg-Hau", gfa: "2,497 m²", date: "10/2025", status: "Fertiggestellt", image: "images/commercialhalls1.png" },
  { title: "Errichtung von 2 Gewerbehallen und 7 Gebäuden mit 136 Garagen", location: "Derner Straße 11, Lünen", gfa: "4,480 m²", date: "Im Bau", status: "In Arbeit", image: "images/underconstruction1.png" },
  { title: "Neubau einer Gewerbehalle und 7 Gebäuden für 148 Garagen", location: "Empeler Straße 91a, Rees", gfa: "4,633 m²", date: "Im Bau", status: "In Arbeit", image: "images/ref-project-8.jpg" },
  { title: "Umbau Bürogebäude, Lagerhalle und Waschstraße", location: "Borsigstraße 2, Goch", gfa: "3,540 m²", date: "Im Bau", status: "In Arbeit", image: "images/ref-project-9.jpg" },
];

function groupByPeriod(items: Project[]): [string, Project[]][] {
  const map = new Map<string, Project[]>();
  for (const item of items) {
    const key = item.date.includes("/") ? item.date.split("/")[1] : "laufend";
    if (!map.has(key)) map.set(key, []);
    map.get(key)!.push(item);
  }
  return [...map.entries()].sort(([a], [b]) => a.localeCompare(b));
}

const residentialGroups = groupByPeriod(residential);
const commercialGroups = groupByPeriod(commercial);
---
<Layout title="Referenzen | Bauunternehmen Goch, NRW" description="80+ abgeschlossene Bauprojekte in NRW – Wohn- und Gewerbebau.">
  <section class="relative bg-ink flex flex-col items-center pt-5 pb-10 w-full overflow-hidden">
    <CornerGrid class="absolute -top-1 -left-1 w-78.75 h-60.5 opacity-20 rotate-180 z-0" />
    <CornerGrid class="absolute -bottom-1 -right-1 w-52.5 h-42 opacity-20 z-0" />

    <div class="h-20 w-full shrink-0"></div>

    <div class="relative z-10 flex flex-col items-start w-full max-w-310 pt-16 pb-6 px-15">
      <h1 class="font-semibold text-white text-[56px] md:text-[80px] leading-none tracking-[-3.2px]">Referenzen</h1>
    </div>
  </section>

  <section class="bg-white flex flex-col gap-25 items-start px-6 md:px-15 py-16 md:py-20 w-full">
    <ReferenceCategorySection
      title="Mehrfamilienhäuser"
      tags={["Einfamilien", "Doppel", "Reihen- und Mehrfamilienhäuser"]}
      groups={residentialGroups}
      defaultOpenKey={residentialGroups[0]?.[0]}
    />
    <ReferenceCategorySection
      title="Bürogebäude, Gewerbe- und Garagenhallen"
      tags={["Bürogebäude", "Gewerbe", "Garagenhallen"]}
      groups={commercialGroups}
    />
  </section>

  <ContactCTA />
</Layout>
