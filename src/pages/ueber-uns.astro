---
import Layout from "../layouts/Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import CornerGrid from "../components/CornerGrid.astro";

const stats = [
  { value: "15+", label: "Jahre Erfahrung" },
  { value: "37", label: "Qualifizierte Mitarbeiter" },
  { value: "25M€", label: "Umsatz 2025", trend: true },
  { value: "80+", label: "Abgeschlossene Projekte", trend: true },
];

const values = [
  { title: "Qualität", text: "Hochwertige Materialien und qualifizierte Fachkräfte für nachhaltige Bauleistungen." },
  { title: "Termintreue", text: "Strukturierte Abläufe für termingerechte Umsetzung Ihrer Bauvorhaben." },
  { title: "Wirtschaftlichkeit", text: "Transparente Kalkulation für maximalen Mehrwert jeder Investition." },
  { title: "Partnerschaft", text: "Vertrauensvolle Zusammenarbeit auf Augenhöhe, mit allen Beteiligten." },
];

const revenue = [
  { year: "2022.", value: "10M€" },
  { year: "2023.", value: "15M€" },
  { year: "2024.", value: "18M€" },
  { year: "2025.", value: "25M€", highlight: true },
];
---
<Layout title="Über uns | Bauunternehmen Goch, NRW" description="Regional und vertrauensvoller Partner seit über 15 Jahren.">
  <!-- Hero -->
  <section class="relative bg-ink flex flex-col items-center pt-5 pb-10 w-full overflow-hidden">
    <CornerGrid class="absolute -top-1 -left-1 w-78.75 h-60.5 opacity-50 rotate-180 z-0" />
    <CornerGrid class="absolute -bottom-1 -right-1 w-52.5 h-42 opacity-60 z-0" />

    <div class="h-20 w-full shrink-0"></div>

    <div class="relative z-10 flex flex-col items-start w-full max-w-310 pt-16 pb-6 px-15">
      <h1 class="font-semibold text-white text-[56px] md:text-[80px] leading-none tracking-[-3.2px]">Über uns</h1>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-skyblue flex flex-col sm:flex-row items-start sm:items-center justify-between px-15 py-2.5 w-full">
    {stats.map((s, i) => (
      <div class:list={["flex flex-col gap-1 justify-center py-4 sm:py-0 w-full sm:w-62.5", i > 0 && "sm:border-l border-skyblueLine/50 sm:pl-7.5"]}>
        <h2 class="font-bold text-black text-[32px] leading-normal">{s.value}</h2>
        <div class="flex items-center gap-1">
          <p class="font-normal text-black text-base">{s.label}</p>
          {s.trend && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
              <path d="M7 17L17 7M17 7H9M17 7V15" stroke="#1D1B24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- Unser Ansatz -->
  <section class="bg-white flex flex-col lg:flex-row gap-15 items-stretch px-15 py-20 w-full">
    <div class="flex-1 flex flex-col gap-7.5 items-start">
      <div class="flex flex-col gap-4 items-start w-full">
        <div class="flex gap-2.5 items-center">
          <span class="bg-accent size-1.5 shrink-0"></span>
          <p class="font-medium text-ink text-sm leading-none">Unser Ansatz</p>
        </div>
        <h2 class="font-display text-ink text-[32px] md:text-[40px] tracking-[-1.6px] leading-[1.1]">Was uns antreibt und auszeichnet.</h2>
      </div>
      <div class="flex-1 w-full min-h-75 rounded-2xl overflow-hidden [clip-path:polygon(0_0,calc(100%-56px)_0,100%_56px,100%_100%,0_100%)]">
        <img src="/images/ueber-uns-hero.jpg" alt="Baustelle bei Sonnenuntergang" class="w-full h-full object-cover" />
      </div>
    </div>
    <div class="flex-1 flex flex-col items-start">
      {values.map((v, i) => (
        <div class:list={["flex flex-col gap-3 items-start py-6 w-full", i > 0 && "border-t border-skyblue"]}>
          <h3 class="font-medium text-ink text-lg tracking-[-0.36px]">{v.title}</h3>
          <p class="font-normal text-muted text-lg leading-[1.2] tracking-[-0.72px]">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Umsatz -->
  <section class="flex flex-col items-start px-6 pb-20 w-full">
    <div class="bg-sand flex flex-col gap-10 items-center p-8 md:p-15 rounded-[40px] w-full">
      <div class="flex flex-col gap-4 items-center w-full">
        <div class="flex gap-2.5 items-center">
          <span class="bg-accent size-1.5 shrink-0"></span>
          <p class="font-medium text-ink text-sm leading-none">Umsatz</p>
        </div>
        <h2 class="font-display text-accent text-[32px] md:text-[40px] text-center tracking-[-1.6px] leading-[1.1]">Kontinuierliches Wachstum.</h2>
        <p class="font-normal text-ink text-lg text-center leading-[1.2] tracking-[-0.72px]">Wirtschaftliche Stabilität und Verlässlichkeit seit 2022.</p>
      </div>
      <div class="flex flex-wrap gap-5 items-center justify-center">
        {revenue.map((r, i) => (
          <>
            {i > 0 && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
                <path d="M5 12h14m0 0l-6-6m6 6l-6 6" stroke="#1D1B24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            <div class:list={["flex gap-1 items-center justify-center px-5 py-3 rounded-full shrink-0 whitespace-nowrap", r.highlight ? "bg-accent" : "bg-ink"]}>
              <span class="font-normal text-[#d3d3d3] text-base leading-none">{r.year}</span>
              <span class="font-display text-white text-xl leading-none tracking-[-0.4px]">{r.value}</span>
            </div>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- Zitat -->
  <section class="relative bg-accent flex items-center justify-center px-15 py-20 md:py-25 w-full overflow-hidden [clip-path:polygon(0_0,calc(100%-56px)_0,100%_56px,100%_100%,0_100%)]">
    <CornerGrid class="absolute -top-1 -left-1 w-52.5 h-42 opacity-60 rotate-180 z-0" />
    <CornerGrid class="absolute -bottom-1 -right-1 w-52.5 h-42 opacity-60 z-0" />

    <blockquote class="relative z-10 flex flex-col gap-4 items-center w-full max-w-181">
      <p class="font-semibold text-[#e9e9e9] text-[28px] md:text-[40px] text-center leading-[1.23] tracking-[-1.6px]">
        „Vertrauen, Transparenz und ein hoher Anspruch an unsere Arbeit bilden die Grundlage unseres Erfolgs.“
      </p>
      <footer class="font-normal text-[#e9e9e9] text-xl text-center tracking-[-0.8px]">— Geschäftsführung</footer>
    </blockquote>
  </section>

  <ContactCTA />
</Layout>
