---
import Layout from "../layouts/Layout.astro";
import ContactCTA from "../components/ContactCTA.astro";

const stats = [
  { value: "15+", label: "Jahre Erfahrung" },
  { value: "37", label: "Qualifizierte Mitarbeiter" },
  { value: "25M€", label: "Umsatz 2025" },
  { value: "80+", label: "Abgeschlossene Projekte" },
];

const values = [
  { title: "Qualität", text: "Hochwertige Materialien und qualifizierte Fachkräfte für nachhaltige Bauleistungen." },
  { title: "Termintreue", text: "Strukturierte Abläufe für termingerechte Umsetzung Ihrer Bauvorhaben." },
  { title: "Wirtschaftlichkeit", text: "Transparente Kalkulation für maximalen Mehrwert jeder Investition." },
  { title: "Partnerschaft", text: "Vertrauensvolle Zusammenarbeit auf Augenhöhe, mit allen Beteiligten." },
];

const revenue = [
  { year: "2022", value: "10M€" },
  { year: "2023", value: "15M€" },
  { year: "2024", value: "18M€" },
  { year: "2025", value: "25M€" },
];
---
<Layout title="Über uns | Bauunternehmen Goch, NRW" description="Regional und vertrauensvoller Partner seit über 15 Jahren.">
  <section class="bg-white flex flex-col gap-4 items-start px-[60px] pt-16 pb-10 w-full">
    <h1 class="font-display text-ink text-[44px] tracking-[-1.6px]">Über uns</h1>
  </section>

  <section class="bg-sand flex flex-col md:flex-row items-start w-full max-w-[1156px] mx-auto rounded-xl overflow-hidden">
    {stats.map((s, i) => (
      <div class:list={["flex-1 flex flex-col gap-2 justify-center p-8", i < stats.length - 1 && "border-r border-skyblueLine"]}>
        <h2 class="font-semibold text-ink leading-none text-[36px] tracking-[-1px]">{s.value}</h2>
        <p class="font-normal text-ink text-sm">{s.label}</p>
      </div>
    ))}
  </section>

  <section class="bg-white flex flex-col md:flex-row gap-[100px] items-start px-[60px] py-20 w-full">
    <div class="flex-1 flex flex-col gap-4">
      <div class="flex gap-2.5 items-center">
        <span class="bg-accent size-1.5 shrink-0"></span>
        <p class="font-medium text-ink text-sm leading-none">Unser Ansatz</p>
      </div>
      <h2 class="font-display text-ink text-[36px] tracking-[-1.4px] leading-[1.2]">Was uns antreibt und auszeichnet.</h2>
    </div>
    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-8">
      {values.map((v) => (
        <div class="flex flex-col gap-2">
          <h3 class="font-semibold text-ink text-xl">{v.title}</h3>
          <p class="font-normal text-[#171b1f] text-base leading-[1.4]">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white flex flex-col md:flex-row gap-[60px] items-center px-[60px] pb-20 w-full">
    <div class="flex-1 flex flex-col gap-6">
      <h2 class="font-display text-ink text-[32px] tracking-[-1px]">Umsatz — Kontinuierliches Wachstum.</h2>
      <p class="font-normal text-[#171b1f] text-lg leading-[1.4]">Wirtschaftliche Stabilität und Verlässlichkeit seit 2022.</p>
      <div class="flex gap-6 flex-wrap">
        {revenue.map((r) => (
          <div class="flex flex-col gap-1">
            <span class="text-muted text-sm">{r.year}</span>
            <span class="font-semibold text-ink text-2xl">{r.value}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="flex-1 w-full h-[320px] rounded-2xl overflow-hidden max-w-[500px]">
      <img src="/images/ueber-uns-hero.jpg" alt="Baustelle bei Sonnenuntergang" class="w-full h-full object-cover" />
    </div>
  </section>

  <section class="bg-skyblue flex items-center justify-center px-[60px] py-16 w-full">
    <blockquote class="font-display text-ink text-[32px] text-center leading-[1.3] tracking-[-1px] max-w-[800px]">
      „Vertrauen, Transparenz und ein hoher Anspruch an unsere Arbeit bilden die Grundlage unseres Erfolgs.“
      <footer class="mt-4 font-sans font-normal text-base text-ink/70">— Geschäftsführung</footer>
    </blockquote>
  </section>

  <ContactCTA />
</Layout>
